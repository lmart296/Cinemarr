# Copy this file to .env and edit it:
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env

# ---- Which compose files to use -------------------------------------------
# Leave the separator as ":" on every OS (it's set below).
#   macOS / Windows:            compose.yaml
#   Linux:                      compose.yaml:compose.linux.yaml
#   Linux + Intel/AMD GPU:      compose.yaml:compose.linux.yaml:compose.gpu.yaml
#   Add :compose.vpn.yaml to any of these to route torrents through a VPN.
COMPOSE_FILE=compose.yaml
COMPOSE_PATH_SEPARATOR=:

# ---- Basics ------------------------------------------------------------------
# Time zone name, e.g. America/New_York, Europe/London
TZ=America/New_York

# Linux: the user that should own the files. Find yours with:  id -u ; id -g
# macOS / Windows: leave as 1000.
PUID=1000
PGID=1000

# Where app settings and media live. Relative paths are relative to this folder.
# Keep media and downloads under DATA_DIR (same drive) so imports are instant.
CONFIG_DIR=./config
DATA_DIR=./data

# ---- Network -----------------------------------------------------------------
# Address the web UIs (qBittorrent, Prowlarr, Radarr, Sonarr, Seerr) listen on.
#   127.0.0.1      = only this computer can open them (safest)
#   your LAN IP    = any device on your home network, e.g. 192.168.1.50
# Never use 0.0.0.0 and never port-forward these on your router.
BIND_IP=127.0.0.1

# Your home network, so Plex treats your devices as local (free playback).
# Usually 192.168.1.0/24 or 192.168.0.0/24 or 10.0.0.0/24.
# Plex only honours this with Plex Pass; on Linux the default already works.
LAN_SUBNET=192.168.1.0/24

# ---- Plex ---------------------------------------------------------------------
# Links the server to your account on FIRST start. Required on macOS/Windows,
# optional on Linux.
# Get one at https://plex.tv/claim (expires in 4 minutes). Leave blank to sign in
# from the browser instead.
PLEX_CLAIM=

# Remote streaming outside your home needs Plex Pass (or a Remote Watch Pass
# per viewer). Off by default; set true only if you have one AND forward
# TCP 32400 on your router.
PLEX_REMOTE_ACCESS=false

# ---- Optional VPN for qBittorrent (needs compose.vpn.yaml) --------------------
# Provider list: https://github.com/qdm12/gluetun-wiki
VPN_PROVIDER=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_COUNTRY=
