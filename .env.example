# Copy this file to .env and edit it:
#   macOS/Linux:  cp .env.example .env && chmod 600 .env
#   Windows:      copy .env.example .env
# (chmod 600: .env can hold your VPN key, so only your user should read it.)

# ---- Which compose files to use -------------------------------------------
# Leave the separator as ":" on every OS (it's set below).
#   macOS / Windows:            compose.yaml
#   Linux:                      compose.yaml:compose.linux.yaml
#   Linux + Intel/AMD GPU:      compose.yaml:compose.linux.yaml:compose.gpu.yaml
#   Add :compose.vpn.yaml to any of these to route torrents through a VPN.
COMPOSE_FILE=compose.yaml
COMPOSE_PATH_SEPARATOR=:

# ---- Basics ------------------------------------------------------------------
# Time zone name, e.g. America/New_York, Europe/London
TZ=America/New_York

# Linux: the user that should own the files. Find yours with:  id -u ; id -g
# macOS / Windows: leave as 1000.
PUID=1000
PGID=1000

# Where app settings and media live. Relative paths are relative to this folder.
# Keep media and downloads under DATA_DIR (same drive) so imports are instant.
CONFIG_DIR=./config
DATA_DIR=./data

# Library folders, relative to DATA_DIR. Change them if your existing library
# lives elsewhere on that drive (e.g. Videos/Movies and "Videos/TV Shows").
MOVIES_DIR=media/movies
TV_DIR=media/tv

# DATA_DIR on its own drive (Linux)? Then: sudo touch "$DATA_DIR/.cinemarr-data"
# on the mounted drive and set this to true. The stack then refuses to start
# when the drive isn't mounted, instead of running on an empty folder.
REQUIRE_DATA_MARKER=false

# ---- Network -----------------------------------------------------------------
# Address the web UIs (qBittorrent, Prowlarr, Radarr, Sonarr, Seerr) listen on.
#   127.0.0.1      = only this computer can open them (safest)
#   your LAN IP    = any device on your home network, e.g. 192.168.1.50
# Never use 0.0.0.0 and never port-forward these on your router.
BIND_IP=127.0.0.1

# This computer's address on your home network, so TVs and phones can find
# Plex. Required on macOS/Windows: Plex listens only on this address there
# (left empty, only this computer can reach it). Optional on Linux.
#   macOS:    ipconfig getifaddr en0      (en1 if that prints nothing)
#   Windows:  ipconfig   -> "IPv4 Address"
#   Linux:    hostname -I
# Give this computer a fixed address in your router so it doesn't change.
SERVER_IP=

# Linux only: your home network, so Plex treats your devices as local.
# Plex only uses this with Plex Pass; without it Plex's default already works.
LAN_SUBNET=192.168.1.0/24

# ---- Plex ---------------------------------------------------------------------
# Optional. Leave blank and sign in from the browser right after the first
# start (see README step 3); until you do, any device on your network could
# claim the server. Or paste a token from https://plex.tv/claim before the
# FIRST start to link it to your account automatically. The token works once
# and expires after 4 minutes; empty this line again after the first start.
PLEX_CLAIM=

# Remote streaming outside your home needs Plex Pass (or a Remote Watch Pass
# per viewer). Off by default; set true only if you have one AND forward
# TCP 32400 on your router. Linux only: ignored on macOS/Windows.
PLEX_REMOTE_ACCESS=false

# Linux + compose.gpu.yaml only: the group that owns the GPU, from
#   stat -c %g /dev/dri/renderD128
RENDER_GID=

# ---- Optional VPN for qBittorrent (needs compose.vpn.yaml) --------------------
# Provider list: https://github.com/qdm12/gluetun-wiki
VPN_PROVIDER=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_COUNTRY=
